
import secrets
import string

# Create a pool of characters for the password.
characters = string.ascii_letters + string.digits + "!@#$%&*?"

try:
    length = int(input("Enter password length (12-64): "))

    if length < 12 or length > 64:
        print("Choose a length between 12 and 64.")
    else:
        # Use secure randomness rather than the basic random module.
        password = "".join(
            secrets.choice(characters) for _ in range(length)
        )

        print("\nGenerated Password:", password)
        print("Store the password securely.")

except ValueError:
    print("Please enter a valid whole number.")
